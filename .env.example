# Copy to .env (local) or set as GitHub repository Variables (for Pages deploys).

# Paystack PUBLIC key (starts with pk_live_ or pk_test_). Never put the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=

# Optional: Formspree form ID (the part after /f/) so custom-order requests and
# new-order details are emailed to you. Without it the forms fall back to WhatsApp.
VITE_FORMSPREE_ID=

# WhatsApp number in international format, digits only (e.g. 27821234567)
VITE_WHATSAPP_NUMBER=27000000000
